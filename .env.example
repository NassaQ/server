ENVIRONMENT="dev"

# SQL Server Credentials
SQL_SERVER="example.database.windows.net"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASS=""

# MongoDB Credentials
MONGO_USER=""
MONGO_PASS=""
MONGO_HOST="example.mongocluster.cosmos.azure.com"
MONGO_DB_NAME=""

# blob storage info
BLOB_STORAGE_TYPE=""                                                                                # options: local, azure, s3
BLOB_CONNECTION_STR="DefaultEndpointsProtocol=https;AccountName=?;AccountKey=?;EndpointSuffix=?"    # azure example
BLOB_STORAGE_CONTAINER_NAME=""

# Message Broker info
MESSAGE_BROKER_URL="amqp://guest:guest@localhost:5672/"

# JWT Config
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"
JWT_SECRET_KEY=""

