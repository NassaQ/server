ENVIRONMENT="dev"
CORS_ORIGINS=["http://127.0.0.1:8080", "http://localhost:8080"]

# SQL Server Credentials
SQL_SERVER="example.database.windows.net"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASS=""

# MongoDB Credentials
MONGO_USER=""
MONGO_PASS=""
MONGO_HOST="example.mongocluster.cosmos.azure.com"
MONGO_DB_NAME=""

# blob storage info
BLOB_STORAGE_TYPE=""                                                                                # options: local, azure, s3
BLOB_CONNECTION_STR="DefaultEndpointsProtocol=https;AccountName=?;AccountKey=?;EndpointSuffix=?"    # azure example
BLOB_STORAGE_CONTAINER_NAME=""

# Message Broker
MESSAGE_BROKER_URL="amqp://guest:guest@localhost:5672/"
OCR_QUEUE_NAME="ocr_queue"
AI_FOUNDRY_QUEUE_NAME="ai_foundry_queue"
PROCESSING_BACKEND="ocr_api"                    # "ocr_api" or "ai_foundry"

AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_API_KEY=""
AZURE_SEARCH_INDEX_NAME="nassaq-chunks"

# Upload constraints
MAX_UPLOAD_SIZE_MB=50

# JWT Config
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"
JWT_SECRET_KEY=""

